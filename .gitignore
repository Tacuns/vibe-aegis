# Vibe Aegis scan output
.aegis/
*.log

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/

# ---------------------------------------------------------------------------
# Never commit credentials or local machine state.
# These patterns exist so an accidental `git add -A` cannot publish a secret.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
credentials.json
service-account*.json
gha-creds-*.json
.npmrc
.netrc
.pypirc
secrets.*
*.secret

# ---------------------------------------------------------------------------
# Private working notes and local assistant state.
#
# These were previously protected only by .git/info/exclude, which lives inside a
# single clone and is never shared or pushed. That is not protection: a fresh clone,
# a CI checkout or a cloud session has no exclude file, so a routine `git add -A`
# would publish them. Listing them here makes the protection travel with the repo.
#
# Only the FILENAMES appear publicly; the contents never leave the machine.
# ---------------------------------------------------------------------------
PROJECT-MEMORY.md
*.private.md
PRIVATE-*.md
NOTES.local.md

# Local state written by AI coding assistants (prompts, memory, queues, machine info)
.refact/
.claude/settings.local.json
.cursor/
.windsurf/
.aider*
.continue/

# Vibe Aegis local state
.aegis-baseline.json
*.sarif
sbom.json

# Build output (never source, but keep it out of the repo)
dist/
build/
out/
.next/
.output/
.svelte-kit/
*.apk
*.aab
*.ipa
